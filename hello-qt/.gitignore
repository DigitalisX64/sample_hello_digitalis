# Qt-for-Android build output. The CMake/androiddeployqt build tree is large
# and machine-specific (absolute Qt SDK paths baked into deployment JSON); it is
# regenerated by the build commands in README.md, so it is not committed.
/build-android/
/build/

# The Qt SDK itself lives OUTSIDE the repo (installed via aqtinstall into
# $QT_INSTALL_DIR; see README.md). It must never be added to the repo
# (multi-GB). This guard catches an accidental in-tree install.
/qt/
/Qt/

# The built APK (~15 MB) is large and the suite ignores *.apk by default
# (see ../.gitignore). It is produced by the README build commands and pulled
# for review rather than committed. Un-comment the next line locally if you
# explicitly want to track it for prebuilt-APK regression staging.
/hello-qt-debug.apk

# Machine-local toolchain locations (qt.dir/sdk.dir) read by build-apk.sh.
local.properties

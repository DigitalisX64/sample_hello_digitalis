<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HelloFirebaseCrashlytics"
        tools:targetApi="31">

        <!-- Firebase auto-registers com.google.firebase.provider.FirebaseInitProvider
             to initialize the default FirebaseApp from google-services resources.
             This sample has no google-services.json, so the provider simply finds
             no default app to build and no-ops (it logs a benign warning, it does
             not crash); MainActivity then initializes Firebase in-code with a dummy
             FirebaseOptions. It is left registered so the module mirrors how a real
             app's startup path exercises the translator. -->

        <activity
            android:name="com.example.hellofirebasecrashlytics.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
